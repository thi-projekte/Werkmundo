# Local integration environment; Start-Local.ps1 generates random passwords on first use.
POSTGRES_PASSWORD=GENERATE
USER_DB_PASSWORD=GENERATE
OFFER_DB_PASSWORD=GENERATE
DOCUMENT_DB_PASSWORD=GENERATE
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=GENERATE
BACKEND_TAG=latest
# Optional: an available Process Engine with the team's Java delegates installed.
LOCAL_PE_URL=http://host.docker.internal:8085/engine-rest
LOCAL_CATALOG_URL=http://host.docker.internal:8083
# Optional real provider key. The AI service otherwise uses its documented stub.
MEGALLM_API_KEY=
# USER_SERVICE_OIDC_SECRET is read from the unchanged original realm by Start-Local.ps1.
