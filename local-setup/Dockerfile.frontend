# ---------- Build Stage ----------
FROM node:20-alpine AS build

WORKDIR /app

COPY frontend/package*.json ./

RUN npm ci

COPY frontend/*.tsx ./
COPY frontend/*.ts ./
COPY frontend/shared ./shared
COPY frontend/View ./View
COPY frontend/ViewModel ./ViewModel
COPY frontend/Model ./Model
COPY frontend/infrastructure ./infrastructure
COPY frontend/app ./app
COPY frontend/public ./public
COPY frontend/index.html ./
COPY frontend/tsconfig.json ./
COPY frontend/tsconfig.app.json ./
COPY frontend/tsconfig.node.json ./
COPY frontend/vite.config.ts ./

# Vite embeds these values into the browser bundle during the build
# Keep them local so the image is independent of frontend/.env
ENV VITE_KEYCLOAK_URL=https://terramax-keycloak.winfprojekt.de
ENV VITE_KEYCLOAK_REALM=werkmundo
ENV VITE_KEYCLOAK_CLIENT_ID=werkmundo-frontend
ENV VITE_USER_SERVICE_URL=/svc/user/api/users
ENV VITE_OFFER_SERVICE_URL=/svc/offer
ENV VITE_INVOICE_SERVICE_URL=/svc/invoice
ENV VITE_CATALOG_SERVICE_URL=/svc/catalog
ENV VITE_PE_URL=http://localhost:8085/engine-rest

RUN npm run build


# ---------- Production Stage ----------
FROM nginx:alpine

COPY local-setup/nginx.frontend.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
