<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_angebotsabwicklung" targetNamespace="http://werkmundo.de/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_angebotsabwicklung">
    <bpmn:participant id="Pool_angebotsabwicklung" name="Angebotsabwicklung" processRef="angebotsabwicklung" />
    <bpmn:participant id="Participant_Frontend" name="Frontend" />
    <bpmn:participant id="Participant_KIService" name="KI-Service" />
    <bpmn:participant id="Participant_Kunde" name="Kunde" />
    <bpmn:messageFlow id="MF_Spracheingabe" name="Spracheingabe" sourceRef="Participant_Frontend" targetRef="Start_SpracheingabeEingegangen" />
    <bpmn:messageFlow id="MF_AuftragZurPositionsermittlung" name="Auftrag zur Positionsermittlung" sourceRef="Call_Angebotsentwurfserstellung" targetRef="Participant_KIService" />
    <bpmn:messageFlow id="MF_Angebotspositionen" name="Angebotspositionen" sourceRef="Participant_KIService" targetRef="Call_Angebotsentwurfserstellung" />
    <bpmn:messageFlow id="MF_Angebotsentwurf" name="Angebotsentwurf" sourceRef="Call_Angebotsentwurfserstellung" targetRef="Participant_Frontend" />
    <bpmn:messageFlow id="MF_Angebotspruefergebnis" name="Angebotsprüfergebnis" sourceRef="Participant_Frontend" targetRef="Call_Angebotsentwurfserstellung" />
    <bpmn:messageFlow id="MF_A_Dokument" name="Dokument" sourceRef="Call_Dokumentenversand" targetRef="Participant_Kunde" />
    <bpmn:messageFlow id="MF_Kundenentscheidung" name="Kundenentscheidung" sourceRef="Participant_Kunde" targetRef="Call_Kundenentscheidungseinholung" />
    <bpmn:messageFlow id="MF_Angebotserinnerung" name="Angebotserinnerung" sourceRef="Call_Kundenentscheidungseinholung" targetRef="Participant_Kunde" />
    <bpmn:messageFlow id="MF_Auftragsabschluss" name="Auftragsabschluss" sourceRef="Participant_Frontend" targetRef="Call_Rechnungsstellung" />
    <bpmn:messageFlow id="MF_Rechnungsentwurf" name="Rechnungsentwurf" sourceRef="Call_Rechnungsstellung" targetRef="Participant_Frontend" />
    <bpmn:messageFlow id="MF_Rechnungspruefergebnis" name="Rechnungsprüfergebnis" sourceRef="Participant_Frontend" targetRef="Call_Rechnungsstellung" />
    <bpmn:messageFlow id="MF_R_Dokument" name="Dokument" sourceRef="Call_Rechnungsstellung" targetRef="Participant_Kunde" />
    <bpmn:textAnnotation id="Annotation_Spracheingabe">
      <bpmn:text>Handwerker schickt in der App eine Sprachnachricht ab → Angebots-Service startet die Instanz (Nachricht spracheingabeEingegangen, Business Key = angebotId)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Annotation_Spracheingabe" associationDirection="None" sourceRef="MF_Spracheingabe" targetRef="Annotation_Spracheingabe" />
  </bpmn:collaboration>
  <bpmn:process id="angebotsabwicklung" name="Angebotsabwicklung" isExecutable="true" camunda:versionTag="4.0" camunda:historyTimeToLive="180">
    <bpmn:documentation>Top-Level-Prozess. Eine Instanz = genau ein Angebot (Business Key = angebotId). Start: Der Handwerker schickt in der App eine Sprachnachricht ab; der Angebots-Service legt das Angebot an und korreliert die Nachricht spracheingabeEingegangen (POST /engine-rest/message, businessKey = angebotId). Startvariablen: angebotId, handwerkerId, kundeId, spracheingabeId. Endzustände: Angebot verworfen | Angebot abgelehnt | Angebot abgelaufen | Rechnung gestellt.</bpmn:documentation>
    <bpmn:startEvent id="Start_SpracheingabeEingegangen" name="Spracheingabe eingegangen">
      <bpmn:documentation>Ausgelöst, wenn der Handwerker in der App (VoiceInputView) die Sprachnachricht abschickt.</bpmn:documentation>
      <bpmn:outgoing>Flow_Start_AES</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_SpracheingabeEingegangen" messageRef="Message_SpracheingabeEingegangen" />
    </bpmn:startEvent>
    <bpmn:callActivity id="Call_Angebotsentwurfserstellung" name="Angebotsentwurfserstellung" calledElement="angebotsentwurfserstellung">
      <bpmn:documentation>Endzustände: Angebotsentwurf bestätigt | Angebotsentwurf verworfen.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="angebotId" target="angebotId" />
        <camunda:in source="handwerkerId" target="handwerkerId" />
        <camunda:in source="kundeId" target="kundeId" />
        <camunda:in source="spracheingabeId" target="spracheingabeId" />
        <camunda:out source="ergebnisAngebotsentwurfserstellung" target="ergebnisAngebotsentwurfserstellung" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_AES</bpmn:incoming>
      <bpmn:outgoing>Flow_AES_GW</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_AngebotsentwurfBestaetigt" name="Angebotsentwurf bestätigt?">
      <bpmn:incoming>Flow_AES_GW</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_Dokumentenversand</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_AngebotVerworfen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_AngebotVerworfen" name="Angebot verworfen">
      <bpmn:incoming>Flow_GW_AngebotVerworfen</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Call_Dokumentenversand" name="Dokumentenversand" calledElement="dokumentenversand">
      <bpmn:documentation>Versendet das bestätigte Angebot an den bei der Angebotserstellung angegebenen Kunden (dokumentart = ANGEBOT).</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="angebotId" target="angebotId" />
        <camunda:in source="kundeId" target="kundeId" />
        <camunda:in sourceExpression="${&#39;ANGEBOT&#39;}" target="dokumentart" />
        <camunda:in sourceExpression="${angebotId}" target="dokumentId" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GW_Dokumentenversand</bpmn:incoming>
      <bpmn:outgoing>Flow_DV_KE</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_Kundenentscheidungseinholung" name="Kundenentscheidungseinholung" calledElement="kundenentscheidungseinholung">
      <bpmn:documentation>Endzustände: Angebot angenommen | Angebot abgelehnt | Angebot abgelaufen.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="angebotId" target="angebotId" />
        <camunda:in source="kundeId" target="kundeId" />
        <camunda:out source="ergebnisKundenentscheidungseinholung" target="ergebnisKundenentscheidungseinholung" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DV_KE</bpmn:incoming>
      <bpmn:outgoing>Flow_KE_GW</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_AngebotAngenommen" name="Angebot angenommen?">
      <bpmn:incoming>Flow_KE_GW</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_Rechnungsstellung</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_Abgelehnt</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_Abgelaufen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_AngebotAbgelaufen" name="Angebot abgelaufen">
      <bpmn:incoming>Flow_GW_Abgelaufen</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Call_Rechnungsstellung" name="Rechnungsstellung" calledElement="rechnungsstellung">
      <bpmn:documentation>Wartet auf die Auftragsausführung, erzeugt die Rechnung aus dem Angebot, lässt sie vom Handwerker prüfen und versendet sie. Endzustand: Rechnung versendet.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="angebotId" target="angebotId" />
        <camunda:in source="handwerkerId" target="handwerkerId" />
        <camunda:in source="kundeId" target="kundeId" />
        <camunda:out source="rechnungId" target="rechnungId" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GW_Rechnungsstellung</bpmn:incoming>
      <bpmn:outgoing>Flow_RS_End</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="End_RechnungGestellt" name="Rechnung gestellt">
      <bpmn:incoming>Flow_RS_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_AES" sourceRef="Start_SpracheingabeEingegangen" targetRef="Call_Angebotsentwurfserstellung" />
    <bpmn:sequenceFlow id="Flow_AES_GW" sourceRef="Call_Angebotsentwurfserstellung" targetRef="Gateway_AngebotsentwurfBestaetigt" />
    <bpmn:sequenceFlow id="Flow_GW_Dokumentenversand" name="Angebotsentwurf bestätigt" sourceRef="Gateway_AngebotsentwurfBestaetigt" targetRef="Call_Dokumentenversand">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ergebnisAngebotsentwurfserstellung == 'ANGEBOTSENTWURF_BESTAETIGT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GW_AngebotVerworfen" name="Angebotsentwurf verworfen" sourceRef="Gateway_AngebotsentwurfBestaetigt" targetRef="End_AngebotVerworfen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ergebnisAngebotsentwurfserstellung == 'ANGEBOTSENTWURF_VERWORFEN'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DV_KE" sourceRef="Call_Dokumentenversand" targetRef="Call_Kundenentscheidungseinholung" />
    <bpmn:sequenceFlow id="Flow_KE_GW" sourceRef="Call_Kundenentscheidungseinholung" targetRef="Gateway_AngebotAngenommen" />
    <bpmn:sequenceFlow id="Flow_GW_Rechnungsstellung" name="Angebot angenommen" sourceRef="Gateway_AngebotAngenommen" targetRef="Call_Rechnungsstellung">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ergebnisKundenentscheidungseinholung == 'ANGEBOT_ANGENOMMEN'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GW_Abgelehnt" name="Angebot abgelehnt" sourceRef="Gateway_AngebotAngenommen" targetRef="End_AngebotAbgelehnt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ergebnisKundenentscheidungseinholung == 'ANGEBOT_ABGELEHNT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GW_Abgelaufen" name="Angebot abgelaufen" sourceRef="Gateway_AngebotAngenommen" targetRef="End_AngebotAbgelaufen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ergebnisKundenentscheidungseinholung == 'ANGEBOT_ABGELAUFEN'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RS_End" sourceRef="Call_Rechnungsstellung" targetRef="End_RechnungGestellt" />
    <bpmn:endEvent id="End_AngebotAbgelehnt" name="Angebot abgelehnt">
      <bpmn:incoming>Flow_GW_Abgelehnt</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:message id="Message_SpracheingabeEingegangen" name="spracheingabeEingegangen" />
