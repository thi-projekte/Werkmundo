        <bpmndi:BPMNLabel>
          <dc:Bounds x="720" y="192" width="21" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Participant_KIService_di" bpmnElement="Participant_KIService" isHorizontal="true">
        <dc:Bounds x="120" y="490" width="960" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Annotation_Produktkatalog_di" bpmnElement="Annotation_Produktkatalog">
        <dc:Bounds x="700" y="404" width="300" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="MF_AuftragZurPositionsermittlung_di" bpmnElement="MF_AuftragZurPositionsermittlung">
        <di:waypoint x="320" y="300" />
        <di:waypoint x="320" y="490" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="205" y="420" width="108" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_Angebotspositionen_di" bpmnElement="MF_Angebotspositionen">
        <di:waypoint x="540" y="490" />
        <di:waypoint x="540" y="300" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="548" y="430" width="105" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_Annotation_Produktkatalog_di" bpmnElement="Assoc_Annotation_Produktkatalog">
        <di:waypoint x="850" y="490" />
        <di:waypoint x="850" y="454" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
