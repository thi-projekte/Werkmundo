      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Versand_End_di" bpmnElement="Flow_Versand_End">
        <di:waypoint x="2160" y="800" />
        <di:waypoint x="2212" y="800" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_0oroevk" bpmnElement="Flow_Vorschau_Senden">
        <di:waypoint x="1075" y="800" />
        <di:waypoint x="1115" y="800" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_0ttnz0j" bpmnElement="Flow_Senden_Empfangen">
        <di:waypoint x="1265" y="800" />
        <di:waypoint x="1305" y="800" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_04qay6r" bpmnElement="Flow_Empfangen_GW">
        <di:waypoint x="1455" y="800" />
        <di:waypoint x="1505" y="800" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_0uwbu8a" bpmnElement="Flow_GW_Geaendert">
        <di:waypoint x="1530" y="775" />
        <di:waypoint x="1530" y="690" />
        <di:waypoint x="1590" y="690" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1469" y="715" width="52" height="27" />
