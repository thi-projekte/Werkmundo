        <dc:Bounds x="1590" y="650" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1pk3h74_di" bpmnElement="Gateway_1pk3h74" isMarkerVisible="true">
        <dc:Bounds x="1835" y="775" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Ausfuehren_di" bpmnElement="Flow_Start_Ausfuehren">
        <di:waypoint x="246" y="380" />
        <di:waypoint x="290" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ausfuehren_Empfangen_di" bpmnElement="Flow_Ausfuehren_Empfangen">
        <di:waypoint x="430" y="380" />
