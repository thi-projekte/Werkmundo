          <dc:Bounds x="189" y="403" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AuftragAusfuehren_di" bpmnElement="Task_AuftragAusfuehren">
        <dc:Bounds x="290" y="340" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AuftragsabschlussEmpfangen_di" bpmnElement="Task_AuftragsabschlussEmpfangen">
