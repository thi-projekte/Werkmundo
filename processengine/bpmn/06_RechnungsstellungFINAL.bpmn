      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RechnungsentwurfAusAngebotErstellen_di" bpmnElement="Task_RechnungsentwurfAusAngebotErstellen">
        <dc:Bounds x="705" y="480" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_12u975n" bpmnElement="Task_RechnungspruefergebnisEmpfangen">
