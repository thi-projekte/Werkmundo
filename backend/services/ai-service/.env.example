# Vorlage fuer lokale Einstellungen:  cp .env.example .env
# .env ist in .gitignore - echte Keys NIE committen.

# ---- LLM (leer = Stub-Ergebnis, kein echter KI-Aufruf) ----
MEGALLM_API_KEY=
# MEGALLM_API_URL=https://ai.megallm.io/v1
# MEGALLM_MODEL=gemini-3-flash-preview
# MEGALLM_MODEL_FALLBACK=google-gemma-4-26b

# ---- Katalog (true = Mock-Katalog im Service, false = catalog-service) ----
CATALOG_MOCK_ENABLED=true
# CATALOG_SERVICE_URL=http://host.docker.internal:8083

# ---- Process Engine (muss auf /engine-rest enden) ----
# CAMUNDA_ENGINE_URL=http://host.docker.internal:8085/engine-rest

# ---- Sicherheit (lokal aus; fuer den Online-Betrieb spaeter) ----
# AI_SECURITY_ENABLED=true
# AI_AUTH_POLICY=process-engine
# AI_REQUIRED_ROLE=process-engine
# AI_TECHNICAL_TOKEN_ENABLED=true
# AI_SERVICE_OIDC_SECRET=
# KEYCLOAK_URL=http://host.docker.internal:8090
# KEYCLOAK_REALM=handwerker-realm

# AI_LOG_LEVEL=DEBUG
